# Copy this file to turn.env and fill in your Cloudflare TURN key (README section 1c).
# turn.env holds a secret: never share it or put it in the public/ folder.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional password lock: with this set, the app asks for the password once per device.
DU_MEET_PASSWORD=
